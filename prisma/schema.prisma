generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Issuer {
  id             String   @id @default(uuid())
  orgName        String
  orgEmail       String
  publicKeyHex   String   @unique
  registryStatus String   @default("PENDING") // PENDING | APPROVED | REVOKED
  licenseNumber  String?
  website        String?
  onChainTxHash  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  credentials    IssuedCredential[]
}

model Verifier {
  id           String   @id @default(uuid())
  orgName      String
  apiKeyHash   String   @unique
  billingTier  String   @default("FREE") // FREE | PAY_PER_USE | SUBSCRIPTION
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  proofRequests ProofRequest[]
}

model CredentialType {
  id          String   @id @default(uuid())
  typeId      Int      @unique @default(autoincrement()) // On-chain Uint<32> for V2 circuit
  name        String   @unique
  description String
  onChainId   String?
  credentials IssuedCredential[]
}

model IssuedCredential {
  id               String   @id @default(uuid())
  patientPublicKey String
  status           String   @default("VALID") // VALID | EXPIRING | REVOKED
  issueDate        DateTime @default(now())
  expiryDate       DateTime?
  onChainTxHash    String?
  onChainTypeId    Int?     // Mirrors the Uint<32> type_id stored in the V2 circuit
  revokedAt        DateTime?
  issuerId         String
  issuer           Issuer         @relation(fields: [issuerId], references: [id])
  credentialTypeId String
  credentialType   CredentialType @relation(fields: [credentialTypeId], references: [id])
}

model ProofRequest {
  id          String   @id @default(uuid())
  nonce       String   @unique
  factRequested String
  status      String   @default("PENDING") // PENDING | VERIFIED | FAILED | EXPIRED
  result      String?  // "valid" | "invalid"
  verifierId  String
  verifier    Verifier @relation(fields: [verifierId], references: [id])
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLogEntry {
  id              String   @id @default(uuid())
  actorType       String   // "patient" | "issuer" | "verifier"
  actionType      String   // "proof_generated" | "credential_issued" | "credential_revoked" | "proof_verified"
  credentialTypeId String?
  verifierId      String?
  result          String?  
  timestamp       DateTime @default(now())
}

model RegistryCache {
  id             String   @id @default(uuid())
  issuerPublicKey String  @unique
  isActive       Boolean  @default(true)
  lastSyncedAt   DateTime @default(now())
  onChainTxHash  String?
}

model FeedbackEntry {
  id        String   @id @default(uuid())
  rating    Int
  category  String
  message   String
  userAgent String?
  createdAt DateTime @default(now())
}
