# VeriHealth Environment Variables
# Copy this file to .env.local and fill in your values

# PostgreSQL (Neon or local)
DATABASE_URL="postgresql://user:password@host:5432/verihealth"

# Admin portal password
ADMIN_SECRET="your-strong-admin-password"

# Deploy endpoint protection key
DEPLOY_SECRET="your-deploy-secret"

# Deployed contract address (set after first deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=""

# Groq AI API key for support chatbot
GROK_API_KEY="gsk_..."

# Midnight network (preprod or mainnet)
NEXT_PUBLIC_MIDNIGHT_NETWORK="preprod"
