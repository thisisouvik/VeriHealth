// verihealth.compact - MVP Circuit for VeriHealth
pragma language_version >= 0.5.1;
import CompactStandardLibrary;

export ledger issued_credentials: Map<Bytes<32>, Boolean>;

constructor() {}

// Issues a credential
export circuit issue_credential(commitment_hash: Bytes<32>): [] {
    issued_credentials.insert(disclose(commitment_hash), disclose(true));
}

// Verifies a credential has been issued and not revoked
export circuit verify_credential(commitment_hash: Bytes<32>): [Boolean] {
    const pub_hash = disclose(commitment_hash);
    return [issued_credentials.member(pub_hash)];
}

// Revokes a credential by removing it from the issued map
export circuit revoke_credential(commitment_hash: Bytes<32>): [] {
    const pub_hash = disclose(commitment_hash);
    if (issued_credentials.member(pub_hash)) {
        issued_credentials.remove(pub_hash);
    }
}
